---
import type { Project } from "../data/projects";
interface Props {
  eyebrow: string;
  heading: string;
  quote?: string;
  author?: string;
  items: Project[];
}
const { eyebrow, heading, quote, author, items } = Astro.props;
---
<section class="catalog wrap">
  <header class="cat-head">
    <p class="t-eyebrow" data-reveal>{eyebrow}</p>
    <h1 class="t-h1" data-reveal>{heading}</h1>
    {quote && (
      <blockquote class="cat-quote" data-reveal>
        <span>«{quote}»</span>
        {author && <cite>{author}</cite>}
      </blockquote>
    )}
  </header>

  <ul class="cat-list">
    {items.map((p) => {
      const meta = [p.luogo, p.anno].filter(Boolean).join(" · ");
      return (
        <li class="proj" data-reveal-group>
          <div class="proj-text" data-reveal>
            <div class="proj-head">
              <h2 class="proj-title">{p.title}</h2>
              {meta && <span class="proj-meta">{meta}</span>}
            </div>
            <p class="proj-desc">{p.description}</p>
            <dl class="proj-specs">
              {p.committente && (<div><dt>committente</dt><dd>{p.committente}</dd></div>)}
              {p.consistenza && (<div><dt>consistenza</dt><dd>{p.consistenza}</dd></div>)}
            </dl>
          </div>
          <div class="proj-thumb" data-reveal>
            <span class="proj-thumb-img"><img src={p.img} alt={`${p.title} — ${p.luogo ?? ""}`} loading="lazy" decoding="async" /></span>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .catalog { padding-top: clamp(50px, 8vw, 100px); }
  .cat-head { max-width: 760px; margin-left: auto; text-align: right; }
  .cat-head .t-h1 { margin: 10px 0 0; }
  .cat-quote { margin: 22px 0 0; display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
  .cat-quote span { font-size: 1.05rem; color: var(--color-ink); font-style: italic; line-height: 1.5; max-width: 60ch; }
  .cat-quote cite { font-size: 0.8rem; color: var(--color-faint); font-style: normal; }

  .cat-list { list-style: none; margin: clamp(50px,7vw,90px) 0 0; padding: 0; display: flex; flex-direction: column; }
  .proj {
    display: grid; grid-template-columns: 1fr 190px; gap: clamp(28px,5vw,64px); align-items: center;
    padding: clamp(36px,5vw,56px) 0; border-top: 1px solid var(--color-line);
  }
  .proj:last-child { border-bottom: 1px solid var(--color-line); }

  .proj-text { text-align: right; }
  .proj-head { display: flex; align-items: baseline; justify-content: flex-end; gap: 16px; }
  .proj-title { font-size: 1.4rem; text-transform: lowercase; }
  .proj-meta { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-faint); white-space: nowrap; }
  .proj-desc { font-size: 0.98rem; color: var(--color-muted); line-height: 1.65; margin: 14px 0 0; margin-left: auto; max-width: 62ch; }
  .proj-specs { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 6px 32px; margin: 18px 0 0; }
  .proj-specs div { display: flex; flex-direction: column; gap: 2px; align-items: flex-end; }
  .proj-specs dt { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-faint); }
  .proj-specs dd { margin: 0; font-size: 0.86rem; color: var(--color-muted); }

  .proj-thumb { position: relative; width: 200px; height: 200px; justify-self: end; }
  .proj-thumb::after {
    content: ""; position: absolute; inset: -13px; border-radius: 50%;
    border: 1px solid var(--color-accent); opacity: 0; transform: scale(0.9);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(.2,.7,.2,1); pointer-events: none;
  }
  .proj-thumb-img {
    display: block; width: 100%; height: 100%; border-radius: 50%; overflow: hidden;
    background: var(--color-surface); box-shadow: 0 10px 30px rgba(20,20,20,0.07);
    transition: box-shadow 0.5s ease;
  }
  .proj-thumb-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1s cubic-bezier(.2,.7,.2,1);
  }
  .proj:hover .proj-thumb::after { opacity: 1; transform: scale(1); }
  .proj:hover .proj-thumb-img { box-shadow: 0 16px 44px rgba(20,20,20,0.12); }
  .proj:hover .proj-thumb-img img { transform: scale(1.07); }

  @media (max-width: 680px) {
    .cat-head { text-align: left; margin-left: 0; }
    .cat-quote { align-items: flex-start; }
    .proj { grid-template-columns: 1fr; gap: 22px; }
    .proj-text { text-align: left; order: 2; }
    .proj-head { justify-content: flex-start; }
    .proj-desc { margin-left: 0; }
    .proj-specs { justify-content: flex-start; }
    .proj-specs div { align-items: flex-start; }
    .proj-thumb { order: 1; justify-self: start; width: 150px; height: 150px; }
  }
</style>
