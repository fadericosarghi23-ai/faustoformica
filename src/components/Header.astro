---
import { site, navItems } from '../data/site';
interface Props { path?: string; }
const { path = '' } = Astro.props;
---
<header class="site-header is-solid" data-transparent="false">
  <div class="container nav-row">
    <div class="nav-head">
      <a class="brand" href="/" aria-label={`${site.name} — architetto, home`}>
        <span class="brand-mark">{site.brandLead} <strong>{site.brandStrong}</strong></span>
      </a>
    </div>
    <nav class="main-nav" aria-label="Principale">
      {navItems.map((i) => (
        <a class="link-underline" href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
  </div>
</header>
