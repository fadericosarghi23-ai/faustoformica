---
import { site } from "../config/site";
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <img src="/images/logo.png" alt="" width="46" height="46" class="foot-logo" />
        <p class="foot-name">{site.wordmarkTop} <strong>{site.wordmarkBottom}</strong></p>
        <p class="t-caption">{site.tagline}</p>
      </div>

      <div class="foot-col">
        <h3 class="t-eyebrow">Contatti</h3>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`tel:${site.phonePrimary.replace(/\s/g, "")}`}>{site.phonePrimary}</a>
        <a href={`tel:${site.phoneSecondary.replace(/\s/g, "")}`}>{site.phoneSecondary}</a>
      </div>

      <div class="foot-col">
        <h3 class="t-eyebrow">Studio</h3>
        <p>{site.addressStudio}</p>
        <p>{site.addressCoworking}</p>
      </div>

      <div class="foot-col">
        <h3 class="t-eyebrow">Legale</h3>
        <a href="/privacy-policy">Privacy policy</a>
        <a href="/cookie-policy">Cookie policy</a>
        <button type="button" class="cookie-manage" id="cookie-manage">Gestione cookie</button>
      </div>
    </div>

    <p class="foot-reg">{site.registration}</p>

    <div class="foot-bottom">
      <span>© <span id="year"></span> {site.companyName} · {site.city}</span>
      <span class="t-caption">{site.domain}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: 140px; padding: 72px 0 40px; background: var(--color-surface); border-top: 1px solid var(--color-line); }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
  .foot-logo { width: 46px; height: 46px; border-radius: 50%; margin-bottom: 16px; }
  .foot-name { font-size: 1.15rem; margin: 0 0 4px; }
  .foot-name strong { font-weight: 500; }
  .foot-col { display: flex; flex-direction: column; gap: 8px; }
  .foot-col h3 { margin-bottom: 8px; }
  .foot-col a, .foot-col p { font-size: 0.9rem; color: var(--color-muted); margin: 0; transition: color 0.2s; }
  .foot-col a:hover { color: var(--color-ink); }
  .cookie-manage {
    align-self: flex-start; background: none; border: 0; padding: 0; font: inherit; font-size: 0.9rem;
    color: var(--color-muted); cursor: pointer; transition: color 0.2s;
  }
  .cookie-manage:hover { color: var(--color-ink); }

  .foot-reg { margin: 56px 0 0; padding-top: 28px; border-top: 1px solid var(--color-line); font-size: 0.78rem; color: var(--color-faint); max-width: 760px; }
  .foot-bottom { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 28px; font-size: 0.82rem; color: var(--color-faint); flex-wrap: wrap; }

  @media (max-width: 820px) {
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 520px) {
    .foot-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const y = document.getElementById("year");
  if (y) y.textContent = String(new Date().getFullYear());
  document.getElementById("cookie-manage")?.addEventListener("click", () => {
    alert("Pannello di gestione cookie da collegare.");
  });
</script>
