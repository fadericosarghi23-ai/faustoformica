---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container top">
    <div class="col-left" itemscope itemtype="https://schema.org/PostalAddress">
      <address>
        <span class="name">Architetto {site.name}</span>
        <span itemprop="streetAddress">{site.address.street}</span>
        <span>
          <span itemprop="postalCode">{site.address.postalCode}</span>
          <span itemprop="addressLocality">{site.address.locality}</span>,
          <span itemprop="addressRegion">{site.address.region}</span>
        </span>
      </address>
      <div class="links">
        <a href="/privacy-policy/">Privacy policy</a>
        <a href="/cookie-policy/">Cookie policy</a>
        <a href="/contatti/">Contatti</a>
      </div>
    </div>
    <div class="col-right">
      <p class="name">{site.footerTagline}</p>
      <div class="links">
        <a href={site.linkedin} target="_blank" rel="noopener me">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="6" y="6" width="36" height="36" rx="6"></rect>
            <line x1="15" y1="21" x2="15" y2="34"></line>
            <circle cx="15" cy="15" r="1.6" fill="currentColor" stroke="none"></circle>
            <path d="M23 34V26c0-3 2.4-5 5.2-5S33 23 33 26v8"></path>
            <line x1="23" y1="21" x2="23" y2="34"></line>
          </svg>
          LinkedIn
        </a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.maps} target="_blank" rel="noopener">Indicazioni</a>
      </div>
    </div>
  </div>
  <div class="container bottom">
    <p>© {year} Architetto {site.name} · {site.ordine} · P.IVA DA COMPILARE</p>
  </div>
</footer>
