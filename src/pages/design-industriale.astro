  description="Progettazione e modellazione 3D di espositori, custodie e oggetti d'arredo. Design industriale dell'Architetto Fausto Formica, Treviglio."
>
  <ProjectList
    eyebrow="progettazione e modellazione 3D"
    heading="Design industriale"
    quote="riconoscere il bisogno è la condizione primaria del design"
    author="Charles Eames"
    items={designIndustriale}
  />
</Base>
