---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site, navItems } from '../data/site';
import { projects } from '../data/projects';
import { projectCover } from '../lib/images';

function titleCase(s: string) {
  return s.split(' ').map((w) => (w.length > 2 ? w.charAt(0).toUpperCase() + w.slice(1) : w)).join(' ');
}

// Progetti in evidenza in home (uno per varietà di categoria e materiale).
const featuredSlugs = ['mauri', 'facile-sestu', 'di-cola', 'work-box', 'cash-42', 'palazzo', 'new-art', 'casati'];
const featured = featuredSlugs
  .map((s) => projects.find((p) => p.slug === s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((p) => ({ ...p, cover: projectCover(p.slug)! }));

const year = new Date().getFullYear();
---
<Layout title={`Architetto a Treviglio | Fausto Formica`} description={site.description} path="/" bare={true} ogImage={featured[0]?.cover.src}>
  <main id="main">
    <h1 class="sr-only">Architetto Fausto Formica — Treviglio</h1>
    <div class="ed">
      <span class="glyph g-tr">Treviglio · Bergamo</span>
      <a class="glyph g-bl" href={`mailto:${site.email}`}>{site.email}</a>
      <span class="glyph g-br">© {year}</span>

      <div class="ed-left">
        <a class="ed-brand" href="/" aria-label={`${site.name} — home`}>{site.brandLead} <strong>{site.brandStrong}</strong></a>
        <nav class="ed-nav" aria-label="Principale">
          {navItems.map((i) => <a class="link-underline" href={i.href}>{i.label}</a>)}
        </nav>
        <div class="ed-active" aria-live="polite">
          {featured.map((p, idx) => (
            <a class={`ed-active-item${idx === 0 ? ' is-active' : ''}`} data-item={idx} href={`/progetti/${p.slug}/`}>
              <span class="ed-active-title">{p.title}</span>
              <span class="ed-active-meta">{titleCase(p.descriptor)} · {p.year}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="ed-center">
        <p class="ed-intro">{site.description}</p>
        <div class="ed-stage">
          {featured.map((p, idx) => (
            <a class={`ed-shot${idx === 0 ? ' is-active' : ''}`} data-shot={idx} href={`/progetti/${p.slug}/`} aria-label={p.title} aria-hidden={idx === 0 ? undefined : 'true'} tabindex={idx === 0 ? undefined : -1}>
              <Image src={p.cover} alt={p.title} widths={[480, 900]} sizes="(min-width:900px) 52vw, 92vw" loading={idx === 0 ? 'eager' : 'lazy'} />
            </a>
          ))}
        </div>
      </div>

      <ul class="ed-index" aria-label="Lavori">
        {featured.map((p, idx) => (
          <li>
            <button type="button" class={`ed-thumb${idx === 0 ? ' is-active' : ''}`} data-thumb={idx} aria-label={p.title}>
              <Image src={p.cover} alt={p.title} widths={[80, 160]} sizes="78px" loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <script>import '../scripts/home.js';</script>
</Layout>
