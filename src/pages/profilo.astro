---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../data/site';

const bio = [
  'Laureato al Politecnico di Milano e iscritto all’Ordine degli Architetti P.P.C. della provincia di Bergamo col n. 2345, inizia la carriera lavorativa nel 1994 collaborando con i principali studi di architettura della zona.',
  'Nel 1998 apre un proprio studio tecnico di progettazione acquisendo ampia esperienza progettuale dapprima in ambito edilizio, occupandosi di progettazione di interni e ristrutturazioni e, successivamente, nell’ambito dell’industrial design.',
  'Dal 2000 allarga il bagaglio di conoscenze anche nel campo della progettazione residenziale ed urbanistica, ponendo particolare attenzione verso le nuove tecniche e i nuovi sistemi progettuali che contraddistingueranno il suo operato.',
  'Nel 2007 la decisione di fondare uno studio associato in grado di far fronte alle sempre più specifiche esigenze del settore, sviluppando anche esperienza internazionale in ambito di project management.',
  'Nel 2008, l’idea di far nascere una società capace di offrire, attraverso una gestione diretta dallo studio preliminare di fattibilità a tutte le fasi dell’appalto fino alla consegna del manufatto, un prodotto che si distinguesse a livello qualitativo sotto il profilo tecnico, progettuale e costruttivo.',
  'Nel 2012, considerato lo sviluppo normativo nel campo del risparmio energetico, si abilita come certificatore energetico iscrivendosi all’Albo dei Soggetti Certificatori della Regione Lombardia col n. 21513.',
  'Dal 2016 sviluppa nuovi ambiti progettuali acquisendo incarichi per la realizzazione di uffici e spazi di lavoro dove, grazie allo studio dei materiali e dei cromatismi e a una progettazione integrata con analisi acustiche e illuminotecniche, il comfort degli spazi diventa l’elemento alla base della progettazione.',
];

const esperienza = [
  { y: '1994 – 1998', t: 'Collaboratore di diversi studi di architettura — pratiche edilizie e modellazione 3D' },
  { y: '1998 – 2000', t: 'Interior & industrial designer presso il proprio studio tecnico' },
  { y: '2000 – 2007', t: 'Progettista presso la società “Archimede S.r.l.”' },
  { y: 'dal 2007', t: 'Libero professionista — studio di architettura, urbanistica e disegno industriale' },
  { y: '2008 – 2019', t: 'Cofondatore e amministratore unico di “Edil System S.r.l.”' },
  { y: '2009', t: 'Project manager presso “Le Ore RS” — Chișinău' },
];

const formazione = [
  { y: '1992', t: 'Diploma scientifico — Liceo “G. Marconi”, Milano' },
  { y: '2006', t: 'Laurea in Architettura — Politecnico di Milano' },
  { y: '2006', t: 'Abilitazione all’esercizio della professione di Architetto' },
  { y: '2007', t: 'Iscrizione all’Ordine degli Architetti di Bergamo — n. 2345' },
  { y: '2012', t: 'Abilitazione a certificatore energetico' },
  { y: '2013', t: 'Accreditamento Soggetti Certificatori Regione Lombardia — n. 21513' },
];
---
<Layout title="Profilo | Architetto Fausto Formica" description="Fausto Formica, architetto a Treviglio: formazione, esperienza e ambiti di progettazione tra architettura, interni e design industriale." path="/profilo/">
  <div class="container studio-wrap">
    <h1 class="sr-only">Profilo</h1>
    <div class="studio-top reveal">
      <blockquote class="studio-statement">Riconoscere il bisogno è la condizione primaria del design.</blockquote>
      <p class="studio-lead">Architetto a Treviglio. Dallo studio di fattibilità alla direzione lavori, lavoro su architettura e urbanistica, design di interni e design industriale, con attenzione al dettaglio costruttivo e al comfort degli spazi.</p>
    </div>

    <div class="profilo-bio reveal">
      {bio.map((p) => <p>{p}</p>)}
    </div>

    <div class="profilo-cols reveal">
      <section class="studio-sec">
        <h2 class="col-h">Cosa faccio</h2>
        <ul class="mini-list">
          {services.map((s) => (
            <li><span class="mini-a">{s.name}</span><br />{s.desc}</li>
          ))}
        </ul>
      </section>
      <section class="studio-sec">
        <h2 class="col-h">Esperienza</h2>
        <ul class="mini-list">
          {esperienza.map((e) => (
            <li><span class="mini-a">{e.t}</span> <span class="mini-y">{e.y}</span></li>
          ))}
        </ul>
      </section>
      <section class="studio-sec">
        <h2 class="col-h">Formazione</h2>
        <ul class="mini-list">
          {formazione.map((e) => (
            <li><span class="mini-a">{e.t}</span> <span class="mini-y">{e.y}</span></li>
          ))}
        </ul>
        <p class="muted mt-3" style="font-size:.82rem">{site.ordine}<br />{site.certificatore}</p>
      </section>
    </div>
  </div>

  <style>
    .profilo-bio { max-width: 52rem; margin: 2.5rem auto 0; display: grid; gap: .9rem; color: #333; line-height: 1.7; font-size: 1rem; }
    .profilo-cols { max-width: 68rem; margin: 3rem auto 0; display: grid; gap: 2.5rem; }
    @media (min-width: 900px) { .profilo-cols { grid-template-columns: 1fr 1fr 1fr; gap: 3rem; align-items: start; } }
    .profilo-cols .mini-list li { padding: .45rem 0; }
  </style>
</Layout>
