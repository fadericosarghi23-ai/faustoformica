---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title="Contatti | Architetto Fausto Formica" description="Indirizzo, telefono ed e-mail dello studio dell’architetto Fausto Formica a Treviglio (BG)." path="/contatti/">
  <div class="container page-head center">
    <h1>Contatti</h1>
    <p class="muted mt-2">Indirizzo, telefono, e-mail</p>
  </div>

  <div class="container contact-info">
    <div>
      <p class="eyebrow">Indirizzo</p>
      <p>{site.address.street}</p>
      <p class="muted">{site.address.street2}</p>
      <p>{site.address.postalCode} {site.address.locality} ({site.address.region})</p>
      <p class="mt-2"><a href={site.maps} target="_blank" rel="noopener">Apri in Google Maps →</a></p>
    </div>

    <div class="mt-4">
      <p class="eyebrow">Telefono</p>
      {site.phones.map((t) => (
        <p><a href={`tel:${t.replace(/\s+/g, '')}`}>{t}</a></p>
      ))}
    </div>

    <div class="mt-4">
      <p class="eyebrow">E-mail</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <div class="mt-4">
      <p class="eyebrow">Orari ufficio</p>
      <p>{site.hours}</p>
    </div>

    <div class="mt-4">
      <p class="eyebrow">Altro</p>
      <p><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></p>
    </div>
  </div>
</Layout>
