---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Architetto Fausto Formica | Architettura | Treviglio",
  description = "Studio dell'Architetto Fausto Formica a Treviglio: architettura, design di interni e design industriale.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://architettofaustoformica.it").href;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- SEO — tutti segnaposto, da compilare al riempimento -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-placeholder.svg" />
    <!-- [[DA COMPILARE: favicon del cliente ]] -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- [[DA COMPILARE: ID analytics / pixel — NESSUNO script di tracciamento attivo nella base ]] -->
    <script is:inline>
      document.documentElement.classList.add("has-js");
    </script>
  </head>
  <body>
    <Preloader />
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import Lenis from "lenis";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // --- Preloader: dissolvenza all'avvio ---
      const pre = document.getElementById("preloader");
      const hidePreloader = () => {
        if (!pre) return;
        gsap.to(pre, {
          autoAlpha: 0,
          duration: 0.6,
          ease: "power2.out",
          onComplete: () => pre.remove(),
        });
      };
      window.addEventListener("load", () => setTimeout(hidePreloader, 350));
      // fallback di sicurezza
      setTimeout(hidePreloader, 3000);

      if (!reduce) {
        gsap.registerPlugin(ScrollTrigger);

        // --- Lenis: smooth scroll ---
        const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((t) => lenis.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);

        // --- Reveal on scroll ---
        const groups = new Map<Element, Element[]>();
        document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
          const key = el.closest("[data-reveal-group]") ?? document.body;
          if (!groups.has(key)) groups.set(key, []);
          groups.get(key)!.push(el);
        });

        groups.forEach((els, key) => {
          gsap.to(els, {
            opacity: 1,
            y: 0,
            duration: 0.9,
            ease: "power3.out",
            stagger: 0.12,
            scrollTrigger: {
              trigger: key === document.body ? els[0] : key,
              start: "top 85%",
            },
          });
        });

        ScrollTrigger.refresh();
      }
    </script>
  </body>
</html>
